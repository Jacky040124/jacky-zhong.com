# OpenAI key for gpt-image-2 build-time image generation (Phase 5).
# Stored OUTSIDE the repo. The build scripts read the key from the path below at runtime.
# Format: a plain text file containing only the API key string.
OPENAI_API_KEY_PATH=/Users/jackytheking/Downloads/openai_api_key.txt

# Optional: HTML in Canvas Origin Trial token for jacky-zhong.com (Phase 4).
# Apply at https://developer.chrome.com/origintrials/ for the canvas-draw-element trial.
# Leave empty until the token is issued; the site degrades gracefully without it.
ORIGIN_TRIAL_CANVAS_DRAW_ELEMENT=
