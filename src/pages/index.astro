---
import '@/styles/global.css';
const title = 'Jacky Zhong — Builder of AI agents and developer communities';
const description = 'Personal portfolio of Jacky Zhong. Vancouver-based builder of AI agents, organizer of developer communities, creative coder.';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,wght@0,400;0,500;0,700;1,400&family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=JetBrains+Mono:wght@400;500&display=swap"
    />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <main class="container section">
      <p class="mono" aria-hidden="true">— Phase 0 / bootstrap</p>
      <h1 class="display" style="font-size: var(--type-display-xl);">Jacky Zhong</h1>
      <p style="font-size: var(--type-body-lg); max-width: 60ch;">
        Vancouver-based builder of AI agents and developer communities.
        Site under construction. Foundation layer (color, type, grid) live; generative layer next.
      </p>
    </main>
  </body>
</html>
