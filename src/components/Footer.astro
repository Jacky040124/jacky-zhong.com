---
import crestUrl from '@/assets/crest.svg';

const social = [
  { label: 'Email', href: 'mailto:me@jacky-zhong.com', display: 'me@jacky-zhong.com' },
  { label: 'LinkedIn', href: 'https://linkedin.com/in/zhong808800', display: 'linkedin.com/in/zhong808800' },
  { label: 'GitHub', href: 'https://github.com/Jacky040124', display: 'github.com/Jacky040124' },
  { label: 'Luma', href: 'https://luma.com/user/jacky0124', display: 'luma.com/user/jacky0124' },
];

const year = new Date().getFullYear();
---

<footer class="site-footer" id="contact">
  <div class="container site-footer__inner">
    <div class="site-footer__crest">
      <img src={crestUrl.src} width={crestUrl.width} height={crestUrl.height} alt="" aria-hidden="true" loading="lazy" />
    </div>

    <div class="site-footer__contact">
      <p class="display site-footer__heading">Trade letters, not platforms.</p>
      <a class="site-footer__mailto display" href="mailto:me@jacky-zhong.com">me@jacky-zhong.com</a>
    </div>

    <dl class="site-footer__channels mono" aria-label="Channels">
      {social.map((entry) => (
        <div class="site-footer__channel">
          <dt>{entry.label}</dt>
          <dd>
            <a href={entry.href} target={entry.href.startsWith('http') ? '_blank' : undefined} rel={entry.href.startsWith('http') ? 'noopener noreferrer me' : undefined}>{entry.display}</a>
          </dd>
        </div>
      ))}
    </dl>

    <p class="site-footer__colophon">
      Built in Vancouver. Type set in Bodoni Moda, Cormorant Garamond, and JetBrains Mono.
      Generative crest authored with p5.js. Imagery generated by gpt-image-2 and post-processed with sharp.
      Hand-set in 2026 by Jacky Zhong. Source on{' '}
      <a href="https://github.com/Jacky040124/jacky-zhong.com" target="_blank" rel="noopener noreferrer">GitHub</a>.
    </p>

    <p class="site-footer__meta mono">© {year} Jacky Zhong · MIT licensed</p>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    z-index: var(--z-footer);
    padding-block: var(--space-7) var(--space-4);
    border-top: 1px solid color-mix(in srgb, var(--color-bone) 12%, transparent);
    background: var(--color-ink-soft);
  }
  .site-footer__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }
  .site-footer__crest {
    display: flex;
    justify-content: center;
  }
  .site-footer__crest img {
    width: clamp(96px, 14vw, 160px);
    opacity: 0.85;
  }
  .site-footer__contact {
    text-align: center;
  }
  .site-footer__heading {
    font-style: italic;
    color: var(--color-bone-soft);
    margin: 0 0 var(--space-2);
    font-size: var(--type-display-md);
  }
  .site-footer__mailto {
    font-size: var(--type-display-lg);
    color: var(--color-bone);
    border-bottom: 1px solid var(--color-brass);
    padding-bottom: 0.1em;
    transition: color var(--hover-duration) var(--hover-ease);
  }
  .site-footer__mailto:hover { color: var(--color-copper); }

  .site-footer__channels {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: var(--space-3);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: var(--type-tracker);
  }
  .site-footer__channel dt {
    color: var(--color-brass);
    margin-bottom: 0.35em;
  }
  .site-footer__channel dd {
    margin: 0;
    color: var(--color-bone);
  }
  .site-footer__channel a {
    text-transform: none;
    letter-spacing: 0.02em;
  }
  .site-footer__colophon {
    color: var(--color-bone-soft);
    font-size: 0.95rem;
    max-width: 60ch;
    margin: 0 auto;
    text-align: center;
    line-height: var(--leading-loose);
  }
  .site-footer__colophon a { border-bottom: 1px solid currentColor; }
  .site-footer__meta {
    text-align: center;
    color: var(--color-bone-soft);
    font-size: var(--type-tracker);
    text-transform: uppercase;
    letter-spacing: 0.2em;
    margin: 0;
  }

  @media (min-width: 768px) {
    .site-footer__inner { gap: var(--space-5); }
  }
</style>
